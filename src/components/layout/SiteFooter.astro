---
import site from '../../data/site.json';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-6 text-sm text-slate-600 sm:px-8 lg:px-12"
  >
    <p>&copy; {currentYear} {site.shortName}.</p>
    <p>{site.contentStatus}</p>
  </div>
</footer>
